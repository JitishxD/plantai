# Copy to .env and edit as needed
# Paths are relative to the backend repo root unless absolute.

MODEL_PATH=artifacts/model_b_combined.keras
CLASS_NAMES_PATH=artifacts/class_names.json

# Must match notebooks/train_model_b_kaggle.ipynb (Model B)
BACKBONE=efficientnetb0
IMG_SIZE=224

USE_TTA=true
CONFIDENCE_THRESHOLD=0.6
TOP_K=3
MAX_UPLOAD_MB=10

HOST=0.0.0.0
PORT=5000
